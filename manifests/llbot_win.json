// manifests/llbot_win.json — Windows 版
// exe llbot→llbot.exe；download linux-x64→win-x64
{
  "name": "llbot", "arch": "standalone", "multi_account": false,
  "exe": "llbot.exe", "install_root": "%LOCALAPPDATA%\\dicemanager\\programs",
  "platform": ["win32"],
  "login_type": "qrcode", "auth_token_conditional": true,
  "compatible_login": ["builtin"],
  "webui_default_port": 3080, "ob11_default_port": 3001,
  "milky_default_port": 3010, "satori_default_port": 5600,
  "config_path": "bin/llbot/default_config.json",
  "data_paths": ["bin/llbot/data"],
  "release_page": "https://github.com/LLOneBot/LuckyLilliaBot/releases",
  // 同 server 版：上游 v8.3.0 改了资产名前缀（LLBot-CLI-* → LuckyLillia-CLI-*），
  // 硬编码 URL 会 404。改用 API + 正则（CLI 完整包，非 Desktop/Docker/arm64）。
  "download_strategy": "resolve_latest_via_api",
  "asset_name_pattern": "CLI-win-x64\\.zip$",
  "post_start_action": "--update", "required_files": ["llbot.exe", "bin/llbot/default_config.json"]
}
