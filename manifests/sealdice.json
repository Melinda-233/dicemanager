// manifests/sealdice.json
{
  "name": "sealdice", "arch": "standalone", "multi_account": true,
  "exe": "sealdice-core", "install_root": "/opt",
  "webui_default_port": 3211,
  "login_type": "external",
  "compatible_login": ["napcat", "llbot", "lagrange", "builtin"],
  "recommended_protocols": ["onebot11-ws-forward", "onebot11-ws-reverse"],
  "config_strategy": "dice.yaml:diceConfigs[].dataDir + serve.yaml:imSession.endPoints",
  "release_page": "https://github.com/sealdice/sealdice-build/releases",
  "download_page_official": "https://sealdice.com/download",
  "download_strategy": "resolve_latest_via_api", "asset_suffix": ".zip",
  "error_keywords": ["ERROR", "panic"],
  "approx_memory_mb": 120, "required_files": ["sealdice-core"]
}